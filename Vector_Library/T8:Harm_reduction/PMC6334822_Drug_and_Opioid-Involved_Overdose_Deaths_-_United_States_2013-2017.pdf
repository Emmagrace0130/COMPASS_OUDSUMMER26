         <xmp:CreatorTool>Adobe InDesign CC 13.0 (Windows)</xmp:CreatorTool>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Drug and Opioid-Involved Overdose Deaths â€” United States, 2013â€“2017</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">In 2017, among 70,237 drug overdose deaths, 47,600 (67.8%) involved opioids, with increases across age groups, racial/ethnic groups, county urbanization levels, and in multiple states. From 2013 to 2017, synthetic opioids contributed to increases in drug overdose death rates in several states. From 2016 to 2017, synthetic opioid-involved overdose death rates increased by 45.2%. </rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Bag/>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Opioid Overdose</rdf:li>
               <rdf:li>Opioid Epidemic</rdf:li>
               <rdf:li>Opioid Crisis</rdf:li>
               <rdf:li>Opioid Abuse</rdf:li>
               <rdf:li>Drug Overdose</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <xmpMM:DocumentID>uuid:4ed3b5a9-bea5-4116-8127-a6699a7602ae</xmpMM:DocumentID>
