                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>XMP08 Spec: An ordered array of plate names that are needed to print the document (including any in contained documents).</pdfaProperty:description>
                           <pdfaProperty:name>PlateNames</pdfaProperty:name>
