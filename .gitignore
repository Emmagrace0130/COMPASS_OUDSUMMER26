# Secrets
.env
*.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# Vector index (rebuilt from PDFs via ingest.py — too large for git)
compass-app/backend/faiss_index/

# Raw source dataset downloads (DEA ARCOS, SAMHSA NSDUH, TEDS, etc.) —
# tens of GB of primary data, exceeds GitHub's file size limits. Keep locally only.
Vector_Library/T3:TN_OUD_data&surv/OUD_data/raw/

# Local symlink mirroring the docker-compose volume mount, for native (non-docker) dev
compass-app/backend/Vector_Library

# Node
node_modules/

# macOS
.DS_Store

# Claude memory
.claude/

# 50 GB archive of Vector_Library — far over GitHub's 100 MB file limit. Keep locally only.
/Vector_Library.zip

# LaTeX build artifacts (the .tex source and final .pdf are tracked)
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.blg
